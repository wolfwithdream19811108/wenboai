{
    "name": "thinkcmf/thinkcmf",
    "description": "ThinkCMF based on ThinkPHP 5.0 , it is a free and open source Content Management Framework(CMF)",
    "type": "project",
    "keywords": [
        "cmf",
        "thinkcmf",
        "framework",
        "thinkphp",
        "ORM"
    ],
    "homepage": "http://www.thinkcmf.com/",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "thinkcmf",
            "email": "zxxjjforever@163.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "elasticsearch/elasticsearch": "^7.11",
        "topthink/think-helper": "^1.0",
        "topthink/think-captcha": "^1.0",
        "phpmailer/phpmailer": "^6.9",
        "mindplay/annotations": "^1.3",
        "topthink/think-image": "^1.0",
        "qiniu/php-sdk": "^7.1",
        "dompdf/dompdf": "^3.1",
        "ezyang/htmlpurifier": "^4.9",
        "topthink/think-queue": "^1.1.4",
        "electrolinux/phpquery": "^0.9.6",
        "phpoffice/phpspreadsheet": "^5.2",
        "alibabacloud/client": "^1.5",
        "phpseclib/phpseclib": "^3.0",
        "alibabacloud/captcha-20230305": "1.1.2",
        "qcloud/cos-sdk-v5": "^2.6",
        "tecnickcom/tcpdf": "^6.7"
    },
    "extra": {
        "think-path": "simplewind/thinkphp"
    },
    "config": {
        "vendor-dir": "simplewind/vendor",
        "allow-plugins": {
            "topthink/think-installer": true
        },
        "secure-http": false
    },
    "scripts": {
        "post-install-cmd": "@php tools/patch_php83_vendor.php",
        "post-update-cmd": "@php tools/patch_php83_vendor.php"
    },
    "repositories": {
    }
}
